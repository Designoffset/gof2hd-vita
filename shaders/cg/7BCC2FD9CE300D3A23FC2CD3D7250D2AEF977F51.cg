// profile sce_vp_psp2

uniform float4x4 u_ModelViewProjectionMatrix;
uniform float3 u_lightdirmodel;
uniform float3 u_eyeposmodel;

void main(
	float4 a_position,
	float2 a_texCoord,
	float3 a_normal,
	float3 a_tangent,
	float3 a_bitangent,
	float2 out v_texCoord : TEXCOORD0,
	float3 out v_light_dir : TEXCOORD3,
	float3 out v_eye_dir : TEXCOORD2,
	float3 out v_lightvec : TEXCOORD4,
	float3 out v_normal : TEXCOORD5,
	float3 out v_specular_dir : TEXCOORD6,
	float4 out gl_Position : POSITION
) {
	gl_Position = mul(a_position, u_ModelViewProjectionMatrix);
	v_texCoord  = a_texCoord;
	v_normal    = a_normal;
	v_light_dir = float3(0.0);
	v_eye_dir   = float3(0.0);

	// This build precomputes the lighting vectors on the CPU and passes them in the
	// tangent/bitangent attributes.
	v_specular_dir = a_tangent;
	v_lightvec     = a_bitangent;
}
