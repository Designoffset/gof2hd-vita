// profile sce_fp_psp2

uniform sampler2D s_texture_0;
uniform sampler2D s_texture_1;
uniform sampler2D s_texture_base;
uniform float2 u_texelSize;

float4 main(float2 v_texCoord : TEXCOORD0, float3 v_eye_dir : TEXCOORD1, float3 v_normalView : TEXCOORD2, float4 gl_FragCoord : WPOS) {
	float4 normalTex = tex2D(s_texture_1, v_texCoord);
	float3 n = normalTex.rgb * 2.0 - 1.0;
	float rim = smoothstep(0.0, 1.0, 1.0 - dot(v_eye_dir, v_normalView));
	float3 rimEffect = smoothstep(0.0, 1.0, 1.0 - dot(v_eye_dir, v_normalView * n)) * float3(0.0, 0.6, 1.0);
	float2 coord = (gl_FragCoord.xy + ((n.xy * 0.4 + v_normalView.xy * rim) * 150.0)) * u_texelSize;
	return float4(tex2D(s_texture_base, coord).rgb + rimEffect, 1.0);
}
