// profile sce_fp_psp2

uniform sampler2D s_texture[2];

float4 main(float2 v_texCoord : TEXCOORD0, float3 v_lightvec : TEXCOORD1, float3 v_specular_dir : TEXCOORD2) {
	float4 colorTex  = tex2D(s_texture[0], v_texCoord);
	float4 normalTex = tex2D(s_texture[1], v_texCoord);
	float3 n = normalTex.rgb * 2.0 - 1.0;
	float s = dot(v_specular_dir, n);
	float4 color;
	if (s > 0.99)      color = float4(0.9, 0.9, 1.0, 1.0);
	else if (s > 0.95) color = float4(0.7, 0.7, 1.0, 1.0);
	else if (s > 0.5)  color = float4(0.3, 0.3, 0.6, 1.0);
	else if (s > 0.25) color = float4(0.2, 0.2, 0.4, 1.0);
	else               color = float4(0.1, 0.1, 0.2, 1.0);
	return colorTex * 0.5 + color;
}
