// profile sce_vp_psp2

uniform float4x4 u_WorldMatrix;
uniform float3 u_light_dir;
uniform float3 u_eye_pos;

void main(
	float4 a_position, float2 a_texCoord, float3 a_normal, float3 a_tangent, float3 a_bitangent,
	float2 out v_texCoord : TEXCOORD0,
	float3 out v_lightvec : TEXCOORD1,
	float4 out gl_Position : POSITION
) {
	gl_Position = mul(a_position, u_WorldMatrix);
	v_texCoord = a_texCoord;
	float3 shine = normalize(normalize(u_eye_pos - a_position.xyz) + u_light_dir);
	// GLSL: mat3(a_tangent, a_bitangent, a_normal) * shine
	v_lightvec = a_tangent * shine.x + a_bitangent * shine.y + a_normal * shine.z;
}
