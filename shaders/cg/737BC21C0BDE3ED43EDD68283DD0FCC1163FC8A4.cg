// profile sce_fp_psp2

uniform sampler2D s_texture_0;
uniform sampler2D s_texture_1;
uniform sampler2D s_texture_2;
uniform float3 u_AmbientColor_0;
uniform float3 u_AmbientColor_1;
uniform float3 u_DiffuseColor_0;
uniform float3 u_DiffuseColor_1;
uniform float3 u_SpecularColor_0;
uniform float3 u_SpecularColor_1;
uniform float u_SpecularPower;
uniform float u_TexBiasDiffuse;
uniform float u_TexBiasNormal;
uniform float u_IsGlowMat;

float4 main(float2 v_texCoord : TEXCOORD0, float3 v_eye_dir : TEXCOORD1, float3 v_specular_dir0 : TEXCOORD2, float3 v_specular_dir1 : TEXCOORD3, float3 v_lightvec0 : TEXCOORD4, float3 v_lightvec1 : TEXCOORD5) {
	float4 colorTex  = tex2Dbias(s_texture_0, float4(v_texCoord, 0.0, u_TexBiasDiffuse));
	float4 normalTex = tex2Dbias(s_texture_1, float4(v_texCoord, 0.0, u_TexBiasNormal));
	if (u_IsGlowMat + colorTex.a > 1.1)
		return float4(colorTex.rgb, colorTex.a);
	float3 n = normalTex.rgb * 2.0 - 1.0;
	float3 specTex = float3(normalTex.a);
	float s1 = pow(saturate(dot(v_specular_dir0, n)), u_SpecularPower);
	float s2 = pow(saturate(dot(v_specular_dir1, n)), u_SpecularPower);
	float d1 = saturate(dot(n, v_lightvec0));
	float d2 = saturate(dot(n, v_lightvec1));
	float3 c = (u_AmbientColor_0 + u_AmbientColor_1 + d1 * u_DiffuseColor_0 + d2 * u_DiffuseColor_1) * colorTex.rgb
		+ (s1 * u_SpecularColor_0 + s2 * u_SpecularColor_1) * specTex;
	return float4(c, colorTex.a);
}
