// profile sce_fp_psp2

uniform sampler2D s_texture;
uniform float4 glColor;

float4 main(float2 v_texCoord : TEXCOORD0, float3 v_DiffuseLight0 : TEXCOORD1, float3 v_DiffuseLight1 : TEXCOORD2, float3 v_SpecularLight0 : TEXCOORD3, float3 v_SpecularLight1 : TEXCOORD4) {
	float4 textureColor = tex2D(s_texture, v_texCoord);
	float3 color = (v_DiffuseLight0 + v_DiffuseLight1) * textureColor.rgb + v_SpecularLight0 + v_SpecularLight1;
	return float4(glColor.rgb * color, glColor.a * textureColor.a);
}
